<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - DriversLink Kenya</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

<header class="navbar">

<div class="welcome">

    <h1 id="welcomeMessage">
        Welcome to DriversLink Kenya
    </h1>

    <p id="accountMessage">
        Your transport connection platform.
    </p>

</div>
    </div>

    <nav>
        <a href="index.html">Home</a>
        <a href="login.html">Logout</a>
    </nav>

</header>


<main class="dashboard">

    <div class="welcome">

        <h1>
            Welcome to DriversLink Kenya
        </h1>

        <p>
            Your transport connection platform.
        </p>

    </div>


    <div class="dashboard-grid">


        <div class="dashboard-card">

            <div class="icon">
                👤
            </div>

            <h2>
                My Profile
            </h2>

            <p>
                Manage your personal information and account.
            </p>

            <a href="driver-profile.html" class="primary-btn">
    View Profile
</a>

        </div>


        <div class="dashboard-card">

            <div class="icon">
                🚘
            </div>

            <h2>
                Find a Driver
            </h2>

            <p>
                Search for drivers available for work.
            </p>

            <button>
                Find Drivers
            </button>

        </div>


        <div class="dashboard-card">

            <div class="icon">
                💼
            </div>

            <h2>
                Driving Jobs
            </h2>

            <p>
                Find available driving opportunities.
            </p>

            <button>
                View Jobs
            </button>

        </div>


        <div class="dashboard-card">

            <div class="icon">
                🚙
            </div>

            <h2>
                My Vehicle
            </h2>

            <p>
                Add and manage your vehicle information.
            </p>

            <button>
                Manage Vehicle
            </button>

        </div>


        <div class="dashboard-card">

            <div class="icon">
                📩
            </div>

            <h2>
                Messages
            </h2>

            <p>
                Communicate with drivers, owners and customers.
            </p>

            <button>
                Open Messages
            </button>

        </div>


        <div class="dashboard-card">

            <div class="icon">
                ⚙️
            </div>

            <h2>
                Settings
            </h2>

            <p>
                Manage your account settings.
            </p>

            <button>
                Settings
            </button>

        </div>


    </div>

</main>


<footer>

    <p>
        © 2026 DriversLink Kenya. All rights reserved.
    </p>

</footer>
<script>

const savedUser = localStorage.getItem("driversLinkUser");

const loggedIn = localStorage.getItem("driversLinkLoggedIn");

if (!savedUser || loggedIn !== "true") {

    window.location.href = "login.html";

} else {

    const user = JSON.parse(savedUser);

    document.getElementById("welcomeMessage").textContent =
        "Welcome, " + user.name + " 👋";

    document.getElementById("accountMessage").textContent =
        "Account type: " + user.accountType;

}

</script>

</body>
</html>
