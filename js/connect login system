<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login - DriversLink Kenya</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

<header class="navbar">

    <div class="logo">
        🚗 DriversLink <span>Kenya</span>
    </div>

    <nav>
        <a href="index.html">Home</a>
        <a href="register.html">Register</a>
    </nav>

</header>


<section class="register-section">

    <div class="register-container">

        <h1>Welcome Back</h1>

        <p class="subtitle">
            Login to your DriversLink Kenya account
        </p>


        <form id="loginForm">

            <label>Email or Phone Number</label>

            <input
                type="text"
                id="loginUser"
                placeholder="Enter email or phone"
                required
            >


            <label>Password</label>

            <input
                type="password"
                id="loginPassword"
                placeholder="Enter your password"
                required
            >


            <button type="submit">
                Login
            </button>

        </form>


        <p class="login-link">
            Don't have an account?
            <a href="register.html">Create account</a>
        </p>

    </div>

</section>


<script>

document.getElementById("loginForm").addEventListener("submit", function(event) {

    event.preventDefault();

    const username = document.getElementById("loginUser").value;

    alert("Login successful! Welcome to DriversLink Kenya, " + username);

});

<script>

document.getElementById("loginForm").addEventListener("submit", function(event) {

    event.preventDefault();

    const username = document.getElementById("loginUser").value;
    const password = document.getElementById("loginPassword").value;

    const savedUser = localStorage.getItem("driversLinkUser");

    if (!savedUser) {

        alert("No account found. Please register first.");

        window.location.href = "register.html";

        return;
    }

    const user = JSON.parse(savedUser);

    if (
        (username === user.email || username === user.phone) &&
        password === user.password
    ) {

        localStorage.setItem("driversLinkLoggedIn", "true");

        window.location.href = "dashboard.html";

    } else {

        alert("Incorrect email/phone or password.");

    }

});

</script>

</body>
</html>
